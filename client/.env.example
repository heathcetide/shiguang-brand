# Development default for Expo Web. For a physical device, use your computer's
# LAN IP instead (for example http://192.168.1.100:9090).
# All distributable preview/production builds read the deployed HTTPS API from
# the matching EAS environment. Plain HTTP is only for local development.
EXPO_PUBLIC_BACKEND_BASE_URL=http://localhost:9090
EXPO_PUBLIC_ALLOW_INSECURE_HTTP=0
EXPO_PUBLIC_DEPLOYMENT_PROFILE=china
EXPO_PUBLIC_APP_NAME=拾味日常
EXPO_PUBLIC_APP_SLUG=dietdigidose
# Package identifiers default by EAS profile; leave unset to preserve preview isolation.

# Optional LOCAL-ONLY disposable demo login. These values are PUBLIC in Expo;
# never use a real user's password, an administrator password or a server secret.
# Both values are required. Development builds only prefill the login fields;
# the password stays masked and no credential hint is rendered above the form.
# Production builds never prefill demo credentials.
EXPO_PUBLIC_DEMO_LOGIN_IDENTIFIER=local_user@example.test
EXPO_PUBLIC_DEMO_LOGIN_PASSWORD=
