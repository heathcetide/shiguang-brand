{
  "name": "expo-app",
  "description": "my-expo-app",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "check-deps": "npx depcheck",
    "lint": "tsc --noEmit && eslint ./ -f ./scripts/formatter.mjs --quiet",
    "build": "expo export --platform web",
    "start": "node --dns-result-order=ipv4first ./node_modules/expo/bin/cli start --web --clear --port 8080",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage --coverageReporters=text-summary",
    "test:watch": "jest --watchAll"
  },
  "jest": {
    "preset": "jest-expo",
    "collectCoverageFrom": [
      "utils/**/*.{ts,tsx}",
      "services/**/*.{ts,tsx}",
      "screens/**/{selectors,use*Data,feed,recommendations,carousel}.{ts,tsx}",
      "components/Screen.tsx",
      "contexts/ThemeContext.tsx"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 40,
        "branches": 40,
        "functions": 35,
        "lines": 42
      }
    }
  },
  "dependencies": {
    "@dietdigidose/contracts": "workspace:*",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
