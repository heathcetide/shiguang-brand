# EditorConfig: https://editorconfig.org
# 保持不同编辑器/IDE 下的代码风格一致

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{go,yaml,yml,json,md,sql,sh}]
indent_size = 2

[*.go]
indent_style = tab

[Makefile]
indent_style = tab

[*.{sql,sh}]
indent_size = 4
