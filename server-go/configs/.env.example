# DietDigiDose environment variables reference
# Copy this file to .env and fill in actual values: cp configs/.env.example configs/.env
# All config is injected via env vars, format: APP_<SECTION>_<FIELD>=VALUE

# ── App ──
APP_APP_NAME=DietDigiDose
APP_APP_ENVIRONMENT=dev

# ── Server ──
APP_SERVER_PORT=8080

# ── Database ──
APP_DATABASE_DRIVER=sqlite
APP_DATABASE_DSN=
# MySQL example: APP_DATABASE_DSN=root:password@tcp(127.0.0.1:3306)/DietDigiDose?charset=utf8mb4&parseTime=True
# PostgreSQL example: APP_DATABASE_DSN=host=localhost user=postgres password=secret dbname=DietDigiDose port=5432 sslmode=disable

# ── Redis ──
APP_REDIS_ADDR=localhost:6379
APP_REDIS_PASSWORD=

# ── JWT auth ──
APP_JWT_ENABLED=false
APP_JWT_SECRET=change-me-in-prod-32bytes!

# ── API docs ──
APP_DOCS_ENABLED=true

# ── Rate limiting ──
APP_RATELIMIT_ENABLED=false
APP_RATELIMIT_RPS=100

# ── Internationalization ──
APP_I18N_ENABLED=true
APP_I18N_DEFAULT_LOCALE=zh-CN
APP_I18N_FALLBACK_LOCALE=en
APP_I18N_TRANSLATIONS_PATH=i18n/translations

# ── Object storage (ling-base/stores) ──
APP_STORAGE_DRIVER=local
APP_STORAGE_ROOT=uploads
# APP_STORAGE_REGION=
# APP_STORAGE_ENDPOINT=
# APP_STORAGE_ACCESS_KEY=
# APP_STORAGE_SECRET_KEY=
# APP_STORAGE_PUBLIC_URL_BASE=

# ── Cache (ling-base/common/cache) ──
APP_CACHE_DRIVER=memory
APP_CACHE_DEFAULT_TTL=10m

# ── Distributed lock (ling-base/common/lock) ──
APP_LOCK_DRIVER=memory
APP_LOCK_DEFAULT_TTL=10s

# ── Retry strategy (ling-base/common/retry) ──
APP_RETRY_MAX_ATTEMPTS=3
APP_RETRY_INITIAL_DELAY=100ms

# ── Fallback (pkg/fallback) ──
APP_FALLBACK_ENABLED=true
APP_FALLBACK_MESSAGE=service temporarily unavailable
