loglevel=error
registry=https://registry.npmmirror.com

# 网络优化
network-concurrency=16
fetch-retries=3
fetch-timeout=60000

# peerDependencies
strict-peer-dependencies=false
auto-install-peers=true

# lockfile 配置
lockfile=true
prefer-frozen-lockfile=true

# semver 选择最高版本
resolution-mode=highest

# 不提示 npm 更新
update-notifier=false
