    "@xmldom/xmldom": "0.8.15",
    "body-parser": "1.20.9",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.3",
    "brace-expansion@5": "5.0.12",
    "glob@13": "14.0.2",
    "@react-native/codegen>glob": "14.0.2",
    "react-native>glob": "14.0.2",
    "@react-native/dev-middleware>chromium-edge-launcher": "2.0.1",
    "compression": "1.8.2",
    "decode-uri-component": "0.5.1",
    "js-yaml@3": "3.15.2",
    "js-yaml@4": "4.3.2",
    "lodash": "4.18.1",
    "minimatch@3": "3.1.4",
    "minimatch@9": "11.0.1",
    "minimatch@10": "11.0.1",
    "nanoid": "3.3.18",
    "node-forge": "1.4.1",
    "path-to-regexp@0.1": "0.1.13",
    "picomatch@2": "2.3.2",
    "picomatch@3": "3.0.2",
    "picomatch@4": "4.0.4",
    "postcss": "8.5.25",
    "proxy-addr": "2.0.8",
    "qs": "6.16.1",
