{
  "name": "shiwei-daily",
  "private": true,
  "version": "1.0.6",
  "scripts": {
    "dev:client": "node ./scripts/run-workspace.mjs client start",
    "dev:server": "node ./scripts/run-workspace.mjs server dev",
    "dev:server-go": "cd server-go && go run ./cmd/server",
    "dev:worker-go": "cd server-go && go run ./cmd/server -worker",
    "dev:admin": "node ./scripts/run-workspace.mjs admin dev",
    "dev:app": "npx --yes concurrently --names client,server-go --prefix-colors cyan,magenta \"npm run dev:client\" \"npm run dev:server-go\"",
    "dev:app:with-express": "npx --yes concurrently --names client,server-go,server --prefix-colors cyan,magenta,green \"npm run dev:client\" \"npm run dev:server-go\" \"npm run dev:server\"",
    "dev:all": "npx --yes concurrently --names app,admin --prefix-colors cyan,magenta \"npm run dev:app\" \"npm run dev:admin\"",
    "dev": "npm run dev:app",
    "build:client": "node ./scripts/run-workspace.mjs client build",
    "build:go": "go -C server-go build -o bin/server ./cmd/server",
    "lint:go": "go -C server-go vet ./cmd/... ./internal/...",
    "test:go": "go -C server-go test -count=1 ./cmd/... ./internal/...",
    "test:go:smoke": "node scripts/smoke-go-runtime.mjs",
    "test:go:postgres": "bash scripts/test-go-postgres.sh -race -count=1",
    "db:go:migrate": "go -C server-go run ./cmd/server -migrate",
    "media:migrate:catalog": "go -C server-go run ./cmd/migrate-media -config configs/config.yaml",
    "media:migrate:catalog": "go -C server-go run ./cmd/migrate-media -config configs/config.yaml",
    "build:server": "node ./scripts/run-workspace.mjs server build",
    "staging:smoke": "node deploy/staging-smoke.mjs",
    "build:admin": "node ./scripts/run-workspace.mjs admin build",
    "validate:toolchain": "node scripts/validate-toolchain.mjs",
    "release:prepare": "node scripts/prepare-build-release.mjs",
    "test:brand": "node --test scripts/brand.test.mjs",
    "test:release": "node --test scripts/prepare-build-release.test.mjs client/scripts/verify-preview-certificate.test.mjs scripts/apk-security.test.mjs",
    "validate:release": "node scripts/validate-release-metadata.mjs",
    "lint:client": "node ./scripts/run-workspace.mjs client lint",
    "lint:server": "node ./scripts/run-workspace.mjs server lint",
    "lint:admin": "node ./scripts/run-workspace.mjs admin lint",
    "lint:all": "npm run lint:client && npm run lint:server && npm run lint:admin",
    "test:client": "node ./scripts/run-workspace.mjs client test",
    "test:server": "node ./scripts/run-workspace.mjs server test",
    "test:admin": "node ./scripts/run-workspace.mjs admin test",
    "test:upstream-security-watch": "node --test scripts/check-image-size-upstream.test.mjs",
    "test:unit": "npm run test:staging-smoke && npm run test:upstream-security-watch && npm run test:client && node ./scripts/run-workspace.mjs server test:unit && npm run test:admin",
    "test:contract": "node ./scripts/run-workspace.mjs server test:contract",
    "test:e2e": "node ./scripts/run-workspace.mjs server test:e2e",
    "test:migrations": "node ./scripts/run-workspace.mjs server db:rehearse -- --owner=quality-gate",
    "test:coverage": "node ./scripts/run-workspace.mjs client test:coverage && node ./scripts/run-workspace.mjs server test:coverage",
    "test:stability": "node scripts/run-test-stability.mjs",
    "contracts:generate": "node ./scripts/run-workspace.mjs packages/contracts openapi:generate",
    "contracts:check": "node ./scripts/run-workspace.mjs packages/contracts check",
    "architecture:check": "node scripts/check-module-boundaries.mjs",
    "provider:smoke": "node scripts/smoke-provider-profiles.mjs",
    "database:schema:generate": "node scripts/generate-postgres-baseline.mjs",
    "database:schema:check": "node scripts/generate-postgres-baseline.mjs --check && node ./scripts/run-workspace.mjs server db:postgres:check",
    "database:boundary:update": "node scripts/check-sqlite-boundary.mjs --update",
    "database:boundary:check": "node scripts/check-sqlite-boundary.mjs",
    "data:audit": "python3 datasets/base-data/source_coverage.py",
    "data:audit:expanded": "python3 datasets/base-data/source_coverage.py --enrichment datasets/releases/concept-enrichment-2026-10-03.1.zip",
    "test:all": "npm run test:brand && npm run test:go && npm run test:dependency-security && npm run test:staging-smoke && npm run test:release && npm run test:upstream-security-watch && npm run test:client && npm run test:server && npm run test:admin",
    "quality:test-quarantine": "node scripts/check-test-quarantine.mjs",
    "quality:build-budgets": "node scripts/check-build-budgets.mjs",
    "test:dependency-security": "node --test scripts/node-forge-security.test.mjs scripts/braces-security.test.mjs scripts/nyc-config-compatibility.test.mjs scripts/query-string-compatibility.test.mjs scripts/release-dependency-compatibility.test.mjs",
    "audit:prod": "npm run test:dependency-security && npm audit --prod --registry=https://registry.npmjs.org",
    "test:staging-smoke": "node --test deploy/staging-smoke.test.mjs deploy/p0-report.test.mjs",
    "docs:generate": "node scripts/readme-docs.mjs --write",
    "docs:check": "node scripts/readme-docs.mjs",
    "test:docs": "node --test scripts/readme-docs.test.mjs"
  },
  "dependencies": {},
  "devDependencies": {},
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": "22.23.2",
    "pnpm": "10.18.0"
  },
  "workspaces": [
    "client",
    "server",
    "admin",
    "packages/*"
  ],
  "overrides": {
    "@tootallnate/once": "2.0.1",
    "esbuild": "0.27.2",
    "@babel/core": "7.29.6",
    "@isaacs/brace-expansion": "5.0.1",
