    "tar": "7.5.22",
    "undici": "6.29.1",
    "uuid": "11.1.1",
    "ws@6": "6.2.4",
    "ws@7": "7.5.11",
    "ws@8": "8.21.0",
    "yaml": "2.8.3",
    "zod@4": "4.6.6"
  },
  "resolutions": {
    "@tootallnate/once": "2.0.1",
    "esbuild": "0.27.2",
    "@babel/core": "7.29.6",
    "@isaacs/brace-expansion": "5.0.1",
    "@xmldom/xmldom": "0.8.15",
    "body-parser": "1.20.9",
    "compression": "1.8.2",
    "decode-uri-component": "0.5.1",
    "lodash": "4.18.1",
    "nanoid": "3.3.18",
    "node-forge": "1.4.1",
    "postcss": "8.5.25",
    "proxy-addr": "2.0.8",
    "qs": "6.16.1",
    "fast-uri": "3.1.9",
    "follow-redirects": "1.16.2",
    "moment": "2.31.0",
    "shell-quote": "1.11.0",
    "source-map-js": "1.2.2",
    "test-exclude": "8.0.0",
    "tar": "7.5.22",
    "undici": "6.29.1",
    "uuid": "11.1.1",
    "yaml": "2.8.3"
  },
  "patchedDependencies": {
    "@siteed/audio-studio@3.2.1": "patches/@siteed__audio-studio@3.2.1.patch",
    "braces@3.0.3": "patches/braces@3.0.3.patch",
    "decode-uri-component@0.5.1": "patches/decode-uri-component@0.5.1.patch"
  }
}
