FROM node:22-bookworm-slim AS build

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@10.18.0 --activate

WORKDIR /workspace
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches ./patches
COPY server/package.json ./server/package.json
COPY packages/contracts/package.json ./packages/contracts/package.json
RUN pnpm config set allowUnusedPatches true \
  && pnpm install --frozen-lockfile --filter server...

COPY server ./server
COPY packages/contracts ./packages/contracts
ARG SERVER_GIT_SHA
RUN SERVER_GIT_SHA="$SERVER_GIT_SHA" pnpm --dir server build
RUN pnpm --filter server --prod deploy --legacy /output/server

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /output/server ./
COPY --from=build /workspace/server/dist ./dist
COPY --from=build /workspace/server/drizzle ./drizzle
COPY --from=build /workspace/server/public ./public
RUN mkdir -p /data && chown -R node:node /app /data
USER node
EXPOSE 9090
CMD ["node", "dist/index.js"]
