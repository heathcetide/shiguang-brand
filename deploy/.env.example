# 必填：冻结候选的完整 40 位小写 Git SHA；与实际构建源码一致。
CANDIDATE_GIT_SHA=
# DNS A/AAAA 记录必须先指向 staging 主机。
STAGING_DOMAIN=staging-api.example.com
ACME_EMAIL=ops@example.com
# 官网“打开 App”按钮的目标；未提供独立客户端 Web 时可指向 /login。
VITE_APP_ENTRY_URL=https://staging-app.example.com
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
# 迁移账号 URL；正式环境应与应用账号分离并由密钥管理器注入。
DATABASE_MIGRATION_URL=postgresql://dietdigidose:replace-with-url-encoded-password@postgres:5432/dietdigidose
# 仅在隔离 staging 接入已审查的 internal-test 音色时设为 1；production 必须保持 0。
VOICE_PACK_ALLOW_INTERNAL_TEST=0
