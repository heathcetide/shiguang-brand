FROM node:22.23.2-alpine AS admin-build

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

RUN corepack enable && corepack prepare pnpm@10.18.0 --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches ./patches
COPY admin/package.json ./admin/package.json
COPY client/package.json ./client/package.json
COPY server/package.json ./server/package.json
COPY packages/contracts/package.json ./packages/contracts/package.json

RUN pnpm config set allowUnusedPatches true \
  && pnpm install --frozen-lockfile --filter admin...

COPY admin ./admin
COPY packages/contracts ./packages/contracts
COPY client/assets/logo.png ./client/assets/logo.png

ARG VITE_APP_ENTRY_URL=/login
ENV VITE_APP_ENTRY_URL=$VITE_APP_ENTRY_URL

RUN pnpm --dir admin build

FROM caddy:2.10.2-alpine

COPY --from=admin-build /app/admin/dist /srv/admin
