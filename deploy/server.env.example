# Go runtime; API/migrate/worker use the same image.
APP_APP_ENVIRONMENT=prod
APP_DATABASE_AUTO_MIGRATE=0
APP_EMBEDDED_WORKER_ENABLED=0
APP_UPSTREAM_EXPRESS=off
APP_DOCS_ENABLED=0
DATABASE_DRIVER=postgresql
# Create a separate DML-only role; this is NOT the PostgreSQL initialization owner.
DATABASE_URL=postgresql://dietdigidose_app:replace-with-url-encoded-password@postgres:5432/dietdigidose
# APP_DATABASE_DRIVER / APP_DATABASE_DSN override shared DATABASE_* names; leave unset here.
DEPLOYMENT_PROFILE=china
JWT_SECRET=replace-with-at-least-32-random-characters
# Initial administrator: inject ADMIN_INITIAL_PASSWORD or ADMIN_INITIAL_PASSWORD_FILE
# ONLY into a one-off migrate container. No default password; existing admin is never reset.
CORS_ORIGINS=https://staging-app.example.com,https://staging-admin.example.com
REQUIRE_HTTPS=1
# Use the actual proxy network, and narrow it where possible.
TRUSTED_PROXY_CIDRS=172.16.0.0/12
MEDIA_LOCAL_ROOT=/data/media

# Optional OpenAI-compatible provider. No real key -> explicit fallback.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_CHAT_MODEL=
AI_VISION_MODEL=
AI_ASR_MODEL=
AI_PROVIDER_NAME=replace-with-provider-legal-name
AI_PROVIDER_PRIVACY_URL=https://provider.example/privacy
AI_PROCESSING_REGION=replace-with-processing-region
AI_CONVERSATION_RETENTION_DAYS=90
PRIVACY_SUPPORT_CONTACT=privacy@example.com

# Optional application update manifest; missing -> 503, not "already latest".
APP_UPDATE_MANIFEST_PATH=

# Inbox scanner only. Compose's interventions profile explicitly enables its worker.
PROACTIVE_INTERVENTIONS_ENABLED=0
INTERVENTION_SCAN_INTERVAL_SEC=60

# Go does not yet implement production SMTP delivery, Supabase community media,
# Express worker task scheduling or automatic legacy Express PostgreSQL conversion.
# Do not copy Express-only variables here and assume those capabilities are enabled.
