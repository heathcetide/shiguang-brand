APP_TIME_ZONE=Asia/Shanghai
DATABASE_DRIVER=postgresql
DATABASE_URL=postgresql://dietdigidose:replace-with-url-encoded-password@postgres:5432/dietdigidose
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
# china: local storage + Aliyun phone verification; global: Supabase storage + password/JWT auth.
DEPLOYMENT_PROFILE=china
PROVIDER_TIMEOUT_MS=10000
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_INITIAL_PASSWORD=replace-with-at-least-12-characters
CORS_ORIGINS=https://staging-app.example.com,https://staging-admin.example.com

AI_PROVIDER_NAME=replace-with-provider-legal-name
AI_PROVIDER_PRIVACY_URL=https://provider.example/privacy
AI_PROCESSING_REGION=replace-with-processing-region
AI_CONVERSATION_RETENTION_DAYS=90
AI_RATE_LIMIT=30
FOOD_SEARCH_RATE_LIMIT=60
REGISTER_RATE_LIMIT=12
REGISTER_GLOBAL_RATE_LIMIT=500
REGISTER_RATE_LIMIT_WINDOW_MS=900000
COMMUNITY_SHARE_RATE_LIMIT=20
COMMUNITY_SHARE_RATE_LIMIT_WINDOW_MS=3600000
PRIVACY_SUPPORT_CONTACT=privacy@example.com
EXTERNAL_REQUEST_TIMEOUT_MS=20000
WORKER_INTERVAL_MS=3600000
WORKER_TASK_TIMEOUT_MS=300000
WORKER_LEASE_MS=600000
WORKER_TASKS=notifications,media-cleanup
MEDIA_CLEANUP_BATCH_SIZE=25

AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_VISION_MODEL=gpt-4o-mini
USDA_API_KEY=
ERROR_MONITOR_WEBHOOK_URL=

# 公开社区图片使用独立 public bucket；service-role 只保存在服务端。
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=community-media
MEDIA_UPLOAD_RATE_LIMIT=30

# 阿里云号码认证服务：AccessKey 只由部署环境注入，不能在管理后台保存。
ALIYUN_SMS_ENABLED=0
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_REGION_ID=cn-hangzhou
ALIYUN_DYPNS_ENDPOINT=dypnsapi.aliyuncs.com
ALIYUN_SMS_SIGN_NAME=恒创联众
ALIYUN_SMS_TEMPLATE_CODE=100001
ALIYUN_SMS_CALLBACK_TOKEN=replace-with-a-long-random-callback-token
AUTH_AUDIT_ENCRYPTION_KEY=replace-with-a-long-random-audit-encryption-key
PUBLIC_APP_URL=https://api.example.com
# 应用内 Android 更新；未配置时明确返回暂不可用，不误报“最新版”。
# 清单通过 release:android:manifest 核验公开 APK 后生成，再原子替换此文件。
APP_UPDATE_MANIFEST_PATH=
# 与 Android 包内 EXPO_PUBLIC_APK_DOWNLOAD_ORIGINS 使用相同的受控 HTTPS origin。
APP_UPDATE_ALLOWED_ORIGINS=
MEDIA_LOCAL_ROOT=/data/media
# 可选：覆盖随服务打包的 GeoLite2 Country MMDB 文件路径。
GEOIP_DATABASE_PATH=
# 仅当受信任的边缘代理会清除客户端同名请求头并重写国家码时设为 1
TRUST_GEO_HEADERS=0

# 周闭环统计的独立环境标识（如 staging）；留空则不能启用统计。
# 还需在管理端启用采集并明确分类真实/测试/演示/自动化账号。
CORE_LOOP_ENVIRONMENT=

# Proactive intervention delivery is opt-in and disabled by default.
# Enables opportunity scanning and delivery; keep disabled until client actions are available.
PROACTIVE_INTERVENTIONS_ENABLED=0

# SMTP email verification/recovery (leave empty to disable honestly).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
