# 服务端监听配置。
# Local strangler mode: root `pnpm dev` sets PORT=9091 and puts Go on 9090.
# Standalone Express (without server-go) can keep 9090.
PORT=9091
HOST=0.0.0.0
NODE_ENV=development
APP_TIME_ZONE=Asia/Shanghai
# 本地默认 sqlite；生产切换时使用 postgresql 并提供 DATABASE_URL。
DATABASE_DRIVER=sqlite
# DATABASE_URL=postgresql://app-user:password@localhost:5432/dietdigidose
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
# 仅本地演示环境按需开启；staging/production 保持为 0。
ENABLE_DEMO_SEED=0
# 可选：开启演示数据时，给 6 个模拟账号设置统一测试密码（至少 12 位）。
# DEMO_USER_PASSWORD=replace-with-a-local-test-password
# AI、食品数据、推送和监控 Webhook 的统一请求超时（毫秒）。
EXTERNAL_REQUEST_TIMEOUT_MS=20000
AI_PROVIDER_NAME=replace-with-provider-legal-name
AI_PROVIDER_PRIVACY_URL=https://provider.example/privacy
AI_PROCESSING_REGION=replace-with-processing-region
AI_CONVERSATION_RETENTION_DAYS=90
# 每 15 分钟、每位登录用户允许的高成本 AI POST 请求数。
AI_RATE_LIMIT=30
# 每 15 分钟、每个来源 IP 允许的匿名外部食品查询数。
FOOD_SEARCH_RATE_LIMIT=60
# 邮箱注册按来源 IP 与全局分别限流；窗口单位为毫秒。
REGISTER_RATE_LIMIT=12
REGISTER_GLOBAL_RATE_LIMIT=500
REGISTER_RATE_LIMIT_WINDOW_MS=900000
# 社区分享码按来源 IP 限流；未过期的同帖子分享码会自动复用。
COMMUNITY_SHARE_RATE_LIMIT=20
COMMUNITY_SHARE_RATE_LIMIT_WINDOW_MS=3600000
PRIVACY_SUPPORT_CONTACT=privacy@example.com
# SQLite 数据库路径；本地未设置时默认为 server/data/dietdigidose.db。
# staging/production 取消下一行注释，并改为持久化磁盘上的绝对路径。
# DATABASE_PATH=/var/lib/dietdigidose/dietdigidose.db

# 生产环境必填，至少 32 个字符。
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
CORS_ORIGINS=https://app.example.com,https://admin.example.com
# 反向代理部署时启用，并由代理写入 X-Forwarded-Proto=https。
TRUST_PROXY=1
REQUIRE_HTTPS=1
# 可选：接收未捕获错误 JSON 事件的监控 webhook。
ERROR_MONITOR_WEBHOOK_URL=

# 仅首次创建管理员时使用，至少 12 位；首次登录后仍会强制修改。
ADMIN_INITIAL_PASSWORD=replace-with-a-strong-bootstrap-password

# 可选：模型服务配置也可以在管理端保存。
AI_API_KEY=
# 也可以使用 OPENAI_API_KEY 作为 AI_API_KEY 的兼容别名。
OPENAI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# 新主助手须完成真实提供商验收后显式设为 true；默认兼容路由，已创建任务保留原策略。
AI_MAIN_ASSISTANT_ENABLED=false
# 验证提供商能力后可启用最终汇总正文流；默认关闭。
AI_REPLY_STREAM_ENABLED=false
AI_VISION_MODEL=gpt-4o-mini
# 可选：三级语音的云端中间层。未配置时复用 AI_BASE_URL / AI_API_KEY。
TTS_BASE_URL=https://api.openai.com/v1
TTS_API_KEY=
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
TTS_RATE_LIMIT=120
# 只允许部署侧注入已完成许可、说话人授权、HTTPS 与 SHA-256 审核的清单；不要提交私有模型或原始录音。
VOICE_PACK_CATALOG_JSON=[]
# internal-test 音色还要求 DEPLOYMENT_ENV 非 production 且显式启用；正式环境必须保持关闭。
DEPLOYMENT_ENV=development
VOICE_PACK_ALLOW_INTERNAL_TEST=0
# 可选：按供应商价格填写，用于 AI 用量页估算费用；未配置时费用显示为 0。
AI_INPUT_COST_PER_MILLION_USD=0
AI_OUTPUT_COST_PER_MILLION_USD=0

# 可选：USDA FoodData Central。未配置时使用限流更严格的 DEMO_KEY。
USDA_API_KEY=

# 可选：Supabase。只有启用 Supabase 数据访问时才需要配置。
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=community-media
MEDIA_UPLOAD_RATE_LIMIT=30

# 邮箱验证码 HMAC 密钥；生产必填，需稳定保存。
AUTH_AUDIT_ENCRYPTION_KEY=replace-with-a-long-random-audit-encryption-key
PUBLIC_APP_URL=http://localhost:9090
# 未配置 Supabase Storage 时使用；生产环境应指向持久化卷。
MEDIA_LOCAL_ROOT=./public
# 可选：覆盖随服务打包的 GeoLite2 Country MMDB 文件路径。
GEOIP_DATABASE_PATH=
# 仅当受信任的边缘代理会清除客户端同名请求头并重写国家码时设为 1
TRUST_GEO_HEADERS=0

# 周闭环统计的独立环境标识（如 staging）；留空则不能启用统计。
# 还需在管理端启用采集并明确分类真实/测试/演示/自动化账号。
CORE_LOOP_ENVIRONMENT=

# Proactive intervention delivery is opt-in and disabled by default.
# Enables opportunity scanning and delivery; keep disabled until client actions are available.
PROACTIVE_INTERVENTIONS_ENABLED=0

# Email ownership verification / password recovery. Unconfigured means unavailable.
# Port 465 uses TLS immediately; other ports require STARTTLS. Certificates are always verified.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
